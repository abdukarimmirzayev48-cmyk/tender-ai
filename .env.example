# Backend API konfiguratsiyasi — nusxa oling: cp .env.example .env
# .env ni git'ga QO'SHMANG (parol bor).

# PostgreSQL DSN (parol bilan to'liq). ETL ham shu o'zgaruvchini o'qiydi.
XT_DB_DSN=dbname=xtxarid user=a1234 password=SIZNING_PAROLINGIZ host=localhost port=5432

# Connection pool o'lchamlari
DB_POOL_MIN=1
DB_POOL_MAX=8

# AI tahlil (5a bosqich) — console.anthropic.com > API Keys
# Faqat backendда o'qiladi, frontendga HECH QACHON chiqmaydi.
# Kalitsiz ham dashboard to'liq ishlaydi — AI bo'limi ko'rinmaydi, xolos.
ANTHROPIC_API_KEY=
# Tahlil chuqurligi: low | medium | high  (standart: medium)
AI_EFFORT=medium

# CORS — frontend ulanganда yoqing (vergul bilan ajratilgan originlar yoki *)
# React (Vite) dev-server odatda :5173 da ishlaydi.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API server (uvicorn) manzili — faqat qulaylik uchun eslatma
# ishga tushirish: .venv/bin/uvicorn api.main:app --reload --port 8000

# Email bildirishnoma (P0-10) — PLATFORMANING pochta serveri.
#
# DIQQAT — BU FOYDALANUVCHI SOZLAMASI EMAS. Foydalanuvchi interfeysда faqat
# O'Z EMAILINI yozadi; xabarni platformaning o'zi shu server orqali yuboradi.
# Host/port/login — operatorning infratuzilma detali, u interfeysга chiqmaydi.
#
# Bo'sh bo'lsa tizim ANIQ xato beradi ("Platformaning pochta serveri
# sozlanmagan"), jimgina "yuborildi" demaydi.
#
# Gmail uchun oddiy parol emas, "App password" kerak.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Jo'natuvchi manzil. Bo'sh bo'lsa SMTP_USER ishlatiladi.
SMTP_FROM=
# STARTTLS (587-port uchun). 465-portда SSL avtomatik. O'chirish: SMTP_TLS=0
SMTP_TLS=1

# Telegram bildirishnoma (P0-10, ikkinchi kanal) — BOT TOKENI.
# Qayerdan olinadi: Telegramда @BotFather > /newbot (yoki /mybots > API Token).
# DIQQAT: token BAZADA SAQLANMAYDI — `notify_settings` da faqat
# `telegram_enabled` va `telegram_chat_id` turadi. Token bilan botni TO'LIQ
# boshqarish mumkin, baza dumpi esa ko'p qo'ldan o'tadi.
# Bo'sh bo'lsa Telegram kanalini yoqib bo'lmaydi — tizim ANIQ xato beradi.
#
# CHAT ID QO'LDA KIRITILMAYDI. Interfeysда "Telegramni ulash" tugmasi bir
# martalik havola beradi (https://t.me/<bot>?start=<token>); foydalanuvchi uni
# bosadi va bot tokenni oladi. FAQAT shu token bilan kelgan suhbat ulanadi —
# tokensiz /start bosgan begona odam obunachi BO'LMAYDI.
#
# Baza patchlari (bir marta, shu tartibda):
#   psql ... -f schema_patch_notify_telegram.sql
#   psql ... -f schema_patch_notify_subscribers.sql
#   psql ... -f schema_patch_notify_link.sql
TELEGRAM_BOT_TOKEN=

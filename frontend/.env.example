# Frontend konfiguratsiyasi — nusxa oling: cp .env.example .env
# Backend API manzili.
#
# `/api` - Vite proksisi orqali, ya'ni SAME-ORIGIN. Auth-4 dan keyin bu
# SHART: sessiya cookie'si boshqa domenga yuborilmaydi (SameSite=Lax).
# To'liq manzil (http://localhost:8000) yozilsa kirish ishlamay qoladi.
VITE_API_BASE=/api

# ERP interfeysining manzili — ixtiyoriy. Faqat HAVOLA uchun ("ERP da
# ishga olish" tugmasi). ERP backendining manzili KERAK EMAS: holatni
# server o'zi o'qiydi (api/erp_status.py).
VITE_ERP_WEB=http://localhost:5174

# =============================================================================
# Tender AI — STAGING muhiti
# =============================================================================
# JOYLASHUVI:  /etc/tenderai/staging.env
# HUQUQLARI:   chown root:tenderai  &&  chmod 0640
#
# BU FAYL NAMUNA. HAQIQIY QIYMATLAR REPOZITORIYAGA TUSHMAYDI —
# `.gitignore` `deploy/env/*.env` ni chetlatadi, faqat `*.example`
# kuzatiladi.
# =============================================================================

APP_ENV=staging

# --- Tarmoq -----------------------------------------------------------------
# Caddyfile dagi `reverse_proxy 127.0.0.1:8001` bilan MOS bo'lsin.
API_PORT=8001
API_WORKERS=2

# Proksi ORTIDA: haqiqiy IP `X-Forwarded-For` dan olinadi.
TRUST_PROXY=1
AUTH_COOKIE_SECURE=1

# HSTS ni CADDY qo'yadi (TLS terminatorining ishi) — bu yerda 0.
HSTS_MAX_AGE=0

# Swagger STAGING da ochiq bo'lishi mumkin (u basic_auth ortida).
API_DOCS=1

# Same-origin: frontend va API bitta domen ostida (`/api/*`).
CORS_ORIGINS=

# --- OMMAVIY MANZIL (MAJBURIY) ----------------------------------------------
# Bildirishnoma havolalari SHUNDAN quriladi. `localhost` bo'lsa
# `api/notify.py:url_tekshir()` yuborishni TO'XTATADI.
PUBLIC_BASE_URL=https://staging.example.uz

# --- Baza -------------------------------------------------------------------
# ENG KAM HUQUQLI rol (`schema_patch_huquq.sql`, `tai_app`).
# Migratsiyalar BOSHQA rol bilan yuriladi — `docs/deploy.md` §6.
XT_DB_DSN=dbname=tenderai_staging user=tai_service password=REPLACE host=127.0.0.1 port=5432
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- ETL --------------------------------------------------------------------
# Timer soatiga bir marta uradi; ilova SHU byudjetda toza to'xtaydi.
ETL_MAX_SECONDS=1500

# --- Jurnal -----------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Embedding (LOKAL — tashqariga matn yubormaydi) --------------------------
EMBED_PROVIDER=local
EMBED_MODEL_PATH=intfloat/multilingual-e5-small
EMBED_THREADS=2
EMBED_PRELOAD=1
EMBED_BATCH=32
EMBED_MAX_SEQ=512
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- AI ---------------------------------------------------------------------
# PULLIK AI O'CHIQ. Yoqish ONGLI qaror (`docs/legal-data-map.md` §5.1).
AI_PAID_ENABLED=0
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5
AI_EFFORT=medium

# --- Bildirishnoma ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
TELEGRAM_BOT_TOKEN=

# --- ERP --------------------------------------------------------------------
ERP_SERVICE_KEY=
ERP_COMPANY_ID=

# --- Zaxira -----------------------------------------------------------------
BACKUP_DIR=/var/backups/tenderai
BACKUP_KEEP_DAYS=14

# =============================================================================
# Tender AI — baza zaxirasi
# =============================================================================
[Unit]
Description=Tender AI zaxira (%i)
After=postgresql.service

[Service]
Type=oneshot
User=tenderai
Group=tenderai
WorkingDirectory=/opt/tenderai/%i/current
EnvironmentFile=/etc/tenderai/%i.env
ExecStart=/opt/tenderai/%i/current/deploy/bin/backup.sh %i
TimeoutStartSec=7200
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tenderai-backup-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tenderai
